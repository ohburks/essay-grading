# Copy to .env and fill in what you use. Everything is optional: with no LLM
# keys, bundled exemplar sessions still carry precomputed demo scores, but
# live grading of a new essay+trace assessment needs a configured provider
# (server key here, or a user's own browser-supplied key in Settings).

# ── LLM provider keys (server-side only; never exposed to the browser) ────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
GITHUB_MODELS_TOKEN=
# Texas A&M AI gateway (chat.tamu.ai → Settings → API Keys). One key reaches
# OpenAI/Anthropic/Gemini models under campus licensing. TAMU_CHAT_API_KEY is
# accepted as an alias. Override the endpoint only if TAMU moves it.
TAMU_AI_API_KEY=
#TAMU_AI_BASE_URL=https://chat-api.tamu.ai/openai
# Ollama needs no key — it is auto-detected at http://localhost:11434

# Default provider shown in pickers (OpenAI | Claude | Gemini | Groq | Mistral |
# GitHub Models | TAMU AI | Ollama)
DEFAULT_PROVIDER=Claude

# ── Storage ────────────────────────────────────────────────────────────────────
# Directory for the SQLite database and generated artifacts (default: backend/data)
#ASSESSMENT_DATA_DIR=
# Full override for the database file path
#ASSESSMENT_DB_PATH=

# ── Citation fact-checking (optional; pip install -e backend[citations]) ─────
# Crossref's "polite pool": an email in every request gets faster, more
# reliable responses per Crossref's etiquette policy. Leave blank for the
# public pool (slower, best-effort). Only used as a fallback when a citation
# has no URL of its own.
CROSSREF_MAILTO=
# Timeout (seconds) for Crossref API calls and source-document downloads.
CITATIONS_FETCH_TIMEOUT_SECS=15
# Minimum delay (seconds) enforced between successive Crossref calls in one run.
CROSSREF_MIN_INTERVAL_SECS=0.2
# Directory for the local ChromaDB store (default: <data dir>/chroma)
#CITATIONS_CHROMA_DIR=
